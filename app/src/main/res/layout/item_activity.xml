<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="0dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/white"
    style="@style/CountLives.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Activity Thumbnail -->
        <ImageView
            android:id="@+id/ivActivityThumb"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:contentDescription="Activity image"
            android:background="@color/primary_blue_700" />

        <!-- Activity Info -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvActivityType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity Type"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue_700" />

            <TextView
                android:id="@+id/tvActivityDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duration"
                android:textSize="14sp"
                android:textColor="@color/secondary_teal_500"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Delete Button (visible on long-press via code) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteActivity"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:contentDescription="Delete activity"
            app:icon="@drawable/ic_baseline_delete_24"
            app:iconTint="@color/white"
            app:cornerRadius="20dp"
            android:backgroundTint="@android:color/holo_red_dark"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
