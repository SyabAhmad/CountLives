<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Button Styles -->
    <style name="Widget.CountLives.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Pill/Rounded Button Style -->
    <style name="Theme.CountLives.PillButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Card Style -->
    <style name="CountLives.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Heading TextAppearance -->
    <style name="TextAppearance.CountLives.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body TextAppearance -->
    <style name="TextAppearance.CountLives.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- ImageButton Style (for consistent icon button appearance) -->
    <style name="Widget.CountLives.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
